# ==============================================================================
# TechBETA 2026 Database & Backup Configuration
# ==============================================================================

# 1. Supabase PostgreSQL Connection Strings
# Replace [PROJECT-REF] and [PASSWORD] with your actual Supabase project credentials.
# You can find these in your Supabase Dashboard under: Project Settings -> Database -> Connection string
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. Google Sheets Backup Webhook URL
# Paste the deployed Google Apps Script Web App URL here.
# Every registration will automatically sync as a new row in your Google Sheet!
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbx.../exec"
