# ==============================================================================
# TechBETA 2026 Environment Configuration Template
# ==============================================================================

# 1. Supabase PostgreSQL Connection Strings
# Replace [PROJECT-REF] and [PASSWORD] with your actual Supabase project credentials.
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. Razorpay Payment Gateway Credentials
# Found in: Razorpay Dashboard -> Settings -> API Keys
# Public Key (exposed to browser checkout modal):
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxxxx"

# Secret Keys (Server-side order creation & HMAC SHA256 signature verification):
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
# Webhook Secret (Configured in Razorpay Dashboard -> Settings -> Webhooks):
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# 3. Google Sheets Backup Webhook URL
# Paste the deployed Google Apps Script Web App URL here.
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbx.../exec"
